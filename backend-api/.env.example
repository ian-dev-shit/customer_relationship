# ============================================================
#  CRM & Business Control API - Environment Template
# ------------------------------------------------------------
#  Copy this file to `.env` in the same directory and replace
#  every placeholder with a real value.  `.env` is gitignored.
#
#      cp .env.example .env
#
#  Loaded automatically by app/config/config.py (pydantic-settings).
#  Any missing required key will crash the app on startup.
# ============================================================

# --- Primary Supabase project (staff: super_admin / admin / sales_agent) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# --- Upstash Redis (OTP storage + failed-login rate limiting) ---
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# --- Gmail SMTP used to send the 6-digit login OTP (port 465, SSL) ---
# Use a Gmail *App Password*, not your normal account password.
SMTP_SENDER=your-app@gmail.com
SMTP_PASSWORD=your-gmail-app-password

# --- Secondary Supabase project (customer portal) ---
SUPABASE_URL_2=https://your-second-project.supabase.co
SUPABASE_KEY_2=your-second-project-key
SUPABASE_SERVICE_KEY_2=your-second-project-service-role-key

# --- Google Gemini (AI-assisted features) ---
GEMINI_API_KEY=your-gemini-api-key

# --- MongoDB (live chat conversations & messages) ---
MONGODB_URL=mongodb://localhost:27017

# --- Optional / non-secret ---
APP_ENV=development

